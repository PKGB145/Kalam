{
  "manifest_version": 3,
  "name": "Kalam Companion",
  "version": "1.2.0",
  "description": "Tracks screen time across all browser tabs and keeps Kalam reminders firing even when Kalam is closed.",
  "permissions": ["tabs", "storage", "alarms", "notifications"],
  "host_permissions": [
    "https://*.lovable.app/*",
    "https://*.lovableproject.com/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://*.lovable.app/*",
        "https://*.lovableproject.com/*",
        "http://localhost/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "128": "icon.png" }
}
